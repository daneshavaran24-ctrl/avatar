# ── Required ────────────────────────────────────────────────────────────────
# Postgres connection string (Liara: from the database add-on page).
DATABASE_URL=postgres://user:password@host:5432/ravi
# Set to false only for a local database without TLS.
# DATABASE_SSL=false

# Signs the admin and visitor cookies. Generate with: openssl rand -hex 32
SESSION_SECRET=
# Encrypts provider keys at rest. Generate with: openssl rand -hex 32
# Changing this makes every key already stored in the admin panel unreadable.
RAVI_KEY_SECRET=

# Answers, embeddings, transcription and the fallback voice all run on OpenAI.
# Without it the assistant cannot reply.
OPENAI_API_KEY=

# ── Optional providers (can also be entered in the admin Keys tab) ──────────
# One key covers both HeyGen and LiveAvatar; the vendor is detected from it.
HEYGEN_API_KEY=
# Best Persian voice quality.
ELEVENLABS_API_KEY=
# Alternative transcription engines.
DEEPGRAM_API_KEY=
GROQ_API_KEY=
# Alternative answer provider.
OPENROUTER_API_KEY=

# ── Optional model overrides ────────────────────────────────────────────────
# OPENAI_MODEL=gpt-4o-mini
# OPENROUTER_MODEL=google/gemini-2.5-flash
# GROQ_STT_MODEL=whisper-large-v3-turbo

# ── Public rate limits (defaults shown; raise or lower as needed) ───────────
# RL_ASK_PER_MIN=20
# RL_ASK_PER_DAY=300
# RL_STT_PER_MIN=20
# RL_TTS_PER_MIN=40
# RL_AVATAR_PER_HOUR=3
# RL_AVATAR_GLOBAL_PER_DAY=200
# RL_LOGIN_PER_15MIN=10
# How much more one IP may do than one visitor, so shared addresses are not
# locked out by a single heavy user.
# RL_IP_MULTIPLIER=15

# ── Used only by scripts/seed-admin.ts, never at runtime ────────────────────
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
